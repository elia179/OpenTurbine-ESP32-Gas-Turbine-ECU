      "expected": true
    },
    {
      "id": "tc2",
      "driver": "max31856",
      "bus": "thermocouple_spi",
      "select": {
        "gpio": 3
      },
      "expected": true
    },
    {
      "id": "adc",
      "driver": "tla2528",
      "bus": "sensor_i2c",
      "address": 16,
      "expected": true
    },
    {
      "id": "io",
      "driver": "tca9534",
      "bus": "sensor_i2c",
      "address": 32,
      "expected": true
    }
  ],
