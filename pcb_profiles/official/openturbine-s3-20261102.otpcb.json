      3,
      45,
      46
    ]
  },
  "buses": [
    {
      "id": "sensor_i2c",
      "kind": "i2c",
      "pins": {
        "sda": 4,
        "scl": 5
      },
      "frequency_hz": 100000
    },
    {
      "id": "thermocouple_spi",
      "kind": "spi",
      "pins": {
        "sck": 12,
        "miso": 13,
        "mosi": 11
      }
    },
    {
      "id": "serial_0",
      "kind": "uart",
      "pins": {
        "tx": 43,
        "rx": 44
      }
    }
  ],
  "devices": [
    {
      "id": "tc1",
      "driver": "max31856",
      "bus": "thermocouple_spi",
      "select": {
        "gpio": 14
      },
      "expected": true
    },
    {
      "id": "tc2",
      "driver": "max31856",
      "bus": "thermocouple_spi",
      "select": {
        "gpio": 3
      },
      "expected": true
    },
    {
      "id": "adc",
      "driver": "tla2528",
      "bus": "sensor_i2c",
      "address": 16,
      "expected": true
    },
    {
      "id": "io",
      "driver": "tca9534",
      "bus": "sensor_i2c",
      "address": 32,
      "expected": true
    },
    {
      "id": "gate_io",
      "driver": "tca9534",
      "bus": "sensor_i2c",
      "address": 33,
      "expected": true
    }
  ],
  "fixed_functions": {
    "output_enable": {
      "gpio": 45,
      "active_high": true,
      "safe_demand": 0,
      "mode": "health_heartbeat",
      "frequency_hz": 100
    },
    "power_stage": {
      "driver": "drv8350s",
      "control_device": "gate_io",
      "spi_bus": "thermocouple_spi",
      "inh_gpio": [
        37,
        38,
        41,
        42,
        2,
        1
      ],
      "spi_hz": 100000,
      "maximum_pwm_hz": 20000
    },
    "supply_voltage": {
      "gpio": 10,
      "divider": 37,
      "reference_mv": 3300,
